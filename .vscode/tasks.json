{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Emmu: web dev server",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/web-dev-server.sh",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Emmu: build UI",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "build",
        "--prefix",
        "${workspaceFolder}/platforms/web/ui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Emmu: cargo build desktop",
      "type": "process",
      "command": "cargo",
      "args": ["build", "-p", "desktop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Emmu: build desktop",
      "dependsOrder": "sequence",
      "dependsOn": ["Emmu: build UI", "Emmu: cargo build desktop"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
