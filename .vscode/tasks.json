{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Emmu: web dev server",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/web-dev-server.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "emmu-web",
        "fileLocation": ["relative", "${workspaceFolder}/platforms/web/ui"],
        "pattern": {
          "regexp": "^__EMMU_NO_PROBLEMS__:(\\d+):(\\d+): (.*)$",
          "line": 1,
          "column": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(> emmu-ui@.* dev|VITE v)",
          "endsPattern": "(Local:.*127\\.0\\.0\\.1:5173|Emmu: servidor web já ativo)"
        }
      }
    },
    {
      "label": "Emmu: build UI",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "build",
        "--prefix",
        "${workspaceFolder}/platforms/web/ui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Emmu: cargo build desktop",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "desktop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
