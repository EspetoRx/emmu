{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Emmu: web dev server",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "dev",
        "--prefix",
        "${workspaceFolder}/platforms/web/ui",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> emmu-ui@.* dev$",
          "endsPattern": "Local:.*127\\.0\\.0\\.1:5173"
        }
      }
    },
    {
      "label": "Emmu: build UI",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "build",
        "--prefix",
        "${workspaceFolder}/platforms/web/ui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Emmu: cargo build desktop",
      "type": "process",
      "command": "cargo",
      "args": ["build", "-p", "desktop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Emmu: build desktop",
      "dependsOrder": "sequence",
      "dependsOn": ["Emmu: build UI", "Emmu: cargo build desktop"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
