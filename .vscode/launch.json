{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Emmu: Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      // Resolve automaticamente a versão instalada pelo Playwright.
      "runtimeExecutable": "${workspaceFolder}/.vscode/chrome-for-testing.sh",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/platforms/web/ui",
      "preLaunchTask": "Emmu: web dev server"
    },
    {
      "name": "Emmu: Desktop (Rust)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/desktop",
      "args": [],
      "cwd": "${workspaceFolder}/platforms/desktop",
      "env": {
        "RUST_BACKTRACE": "1",
        "RUST_LOG": "info",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/crates/emmu-mesen-sys/runtime"
      },
      // O AudioToolbox (SDL) lança exceções C++ internas ao trocar o device de
      // áudio. O CodeLLDB persiste "C++: on throw" entre sessões e pausa nelas.
      "preRunCommands": ["breakpoint name configure --disable cpp_exception"],
      "preLaunchTask": "Emmu: cargo build desktop"
    }
  ]
}
