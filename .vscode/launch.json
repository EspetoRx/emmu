{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Emmu: Web (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "runtimeExecutable": "${env:HOME}/Library/Caches/ms-playwright/chromium-1248/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/platforms/web/ui",
      "preLaunchTask": "Emmu: web dev server"
    },
    {
      "name": "Emmu: Desktop (Rust)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/desktop",
      "args": [],
      "cwd": "${workspaceFolder}/platforms/desktop",
      "env": {
        "RUST_BACKTRACE": "1",
        "RUST_LOG": "info"
      },
      "preLaunchTask": "Emmu: build desktop"
    }
  ]
}
