{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Emmu: Web (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      // Atualizar a versão do Chromium após `npx playwright install chromium`.
      // A versão instalada aparece em ~/Library/Caches/ms-playwright/.
      "runtimeExecutable": "${env:HOME}/Library/Caches/ms-playwright/chromium-1255/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/platforms/web/ui",
      "preLaunchTask": "Emmu: web dev server"
    },
    {
      "name": "Emmu: Desktop (Rust)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/desktop",
      "args": [],
      "cwd": "${workspaceFolder}/platforms/desktop",
      "env": {
        "RUST_BACKTRACE": "1",
        "RUST_LOG": "info",
        "DYLD_LIBRARY_PATH": "/tmp/MesenCE/InteropDLL/obj.osx-arm64"
      },
      // O AudioToolbox (SDL) lança exceções C++ internas ao trocar o device de
      // áudio. O CodeLLDB persiste "C++: on throw" entre sessões e pausa nelas.
      "preRunCommands": ["breakpoint name configure --disable cpp_exception"],
      "preLaunchTask": "Emmu: build desktop"
    }
  ]
}
